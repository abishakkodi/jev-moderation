{
  "name": "jev-moderation",
  "version": "0.1.0",
  "description": "Configurable Jev message moderation and evaluation tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jev-moderation": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "~0.6.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abishakkodi/jev-moderation.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/abishakkodi/jev-moderation#readme",
  "bugs": {
    "url": "https://github.com/abishakkodi/jev-moderation/issues"
  },
  "keywords": [
    "moderation",
    "jev",
    "typesafe",
    "content-moderation",
    "evaluation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
